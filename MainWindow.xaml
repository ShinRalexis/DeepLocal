<Window
    x:Class="DeepLocal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:DeepLocal.Services"
    Title="{Binding [WindowTitle], Source={x:Static s:Loc.I}}"
    Width="1100" Height="660" MinWidth="760" MinHeight="460"
    Icon="Assets/DeepLocal_UserIcon_Framed.ico"
    WindowStartupLocation="Manual"
    Background="{DynamicResource WindowBg}"
    Foreground="{DynamicResource Ink}"
    FontFamily="{StaticResource UiFont}"
    FontSize="14"
    UseLayoutRounding="True"
    PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <s:BoolToVisibility x:Key="BoolVis"/>
    <s:BoolToVisibility x:Key="InvBoolVis" Invert="True"/>
    <s:InvertBool x:Key="Not"/>

    <!-- Modello installato (locale o cloud): tutta la riga seleziona -->
    <DataTemplate x:Key="ModelRow">
      <Button Style="{StaticResource MenuRowButton}" Click="ModelRow_Click" Tag="{Binding}"
              AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentText}"
                     Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                  Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding [Recommended], Source={x:Static s:Loc.I}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentText}"/>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Modello da scaricare: pulsante Scarica, poi avanzamento e Annulla -->
    <DataTemplate x:Key="DownloadRow">
      <Border Padding="10,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource InkMuted}"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource Ink}"/>
              <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                      Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding [Recommended], Source={x:Static s:Loc.I}}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentText}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,1,0,0"/>
            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,6,0,0"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                  Click="DownloadModel_Click" Tag="{Binding}"
                  AutomationProperties.Name="{Binding [Download], Source={x:Static s:Loc.I}}"
                  Visibility="{Binding IsDownloading, Converter={StaticResource InvBoolVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding [Download], Source={x:Static s:Loc.I}}"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                  Content="&#xE711;" Click="CancelDownload_Click" Tag="{Binding}"
                  ToolTip="{Binding [Cancel], Source={x:Static s:Loc.I}}"
                  AutomationProperties.Name="{Binding [Cancel], Source={x:Static s:Loc.I}}"
                  Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===================== Testata ===================== -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="20,0,12,0" Height="56">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/DeepLocal_UserIcon_Framed_64.png" Width="28" Height="28"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="DeepLocal" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource HeaderFg}" Margin="10,0,0,1" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding [AppSubtitle], Source={x:Static s:Loc.I}}" FontSize="13"
                     Foreground="{DynamicResource HeaderMuted}" Margin="12,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Chip del modello: pallino di stato di Ollama, nome, freccia -->
        <ToggleButton x:Name="ModelToggle" Grid.Column="2" Style="{StaticResource HeaderChip}" VerticalAlignment="Center"
                      ToolTip="{Binding [ModelTip], Source={x:Static s:Loc.I}}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=ModelPopup, Converter={StaticResource Not}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OllamaDot" Width="8" Height="8" Fill="{DynamicResource HeaderMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ModelName" Text="…" Margin="9,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="10,2,0,0"
                       Foreground="{DynamicResource HeaderMuted}" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelToggle}" Placement="Bottom"
               HorizontalOffset="-12" VerticalOffset="0" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=ModelToggle, Mode=TwoWay}" Opened="ModelPopup_Opened">
          <Border Style="{StaticResource PopupPanel}" Width="400" Padding="6">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="InstalledHeader" Style="{StaticResource SectionLabel}"
                             Text="{Binding [ModelsInstalled], Source={x:Static s:Loc.I}}"/>
                  <ItemsControl x:Name="InstalledList" ItemTemplate="{StaticResource ModelRow}" Focusable="False"/>
                  <TextBlock x:Name="CloudHeader" Style="{StaticResource SectionLabel}"
                             Text="{Binding [ModelsCloud], Source={x:Static s:Loc.I}}"/>
                  <ItemsControl x:Name="CloudList" ItemTemplate="{StaticResource ModelRow}" Focusable="False"/>
                  <TextBlock x:Name="DownloadHeader" Style="{StaticResource SectionLabel}"
                             Text="{Binding [ModelsToDownload], Source={x:Static s:Loc.I}}"/>
                  <ItemsControl x:Name="DownloadList" ItemTemplate="{StaticResource DownloadRow}" Focusable="False"/>
                </StackPanel>
              </ScrollViewer>
              <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="RefreshModels_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [RefreshModels], Source={x:Static s:Loc.I}}"/>
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
          </Border>
        </Popup>

        <Button x:Name="ClipboardBtn" Grid.Column="3" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"
                VerticalAlignment="Center" Click="ClipboardBtn_Click"
                ToolTip="{Binding [ClipboardTip], Source={x:Static s:Loc.I}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding [ClipboardBtn], Source={x:Static s:Loc.I}}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Border BorderBrush="{DynamicResource HeaderChipBorder}" BorderThickness="1" CornerRadius="4"
                    Padding="5,0,5,1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Alt+T" FontSize="11" Foreground="{DynamicResource HeaderMuted}"/>
            </Border>
          </StackPanel>
        </Button>

        <ToggleButton x:Name="SettingsToggle" Grid.Column="4" Style="{StaticResource HeaderButton}" Width="40" Margin="4,0,0,0"
                      VerticalAlignment="Center" Padding="0"
                      ToolTip="{Binding [SettingsTip], Source={x:Static s:Loc.I}}"
                      AutomationProperties.Name="{Binding [Settings], Source={x:Static s:Loc.I}}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Not}}">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
        </ToggleButton>
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom"
               HorizontalOffset="-276" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}" Opened="SettingsPopup_Opened">
          <Border Style="{StaticResource PopupPanel}" Width="320" Padding="18,14">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="{Binding [Settings], Source={x:Static s:Loc.I}}" FontSize="16" FontWeight="SemiBold"/>

              <TextBlock Text="{Binding [UiLanguage], Source={x:Static s:Loc.I}}" FontSize="13" Margin="0,16,0,6"
                         Foreground="{DynamicResource InkMuted}"/>
              <Border Background="{DynamicResource HoverBg}" CornerRadius="7" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="UiItalian" Style="{StaticResource Segment}" GroupName="UiLang" Content="Italiano"
                               Checked="UiLanguage_Checked" Tag="it"/>
                  <RadioButton x:Name="UiEnglish" Style="{StaticResource Segment}" GroupName="UiLang" Content="English"
                               Checked="UiLanguage_Checked" Tag="en"/>
                </StackPanel>
              </Border>

              <CheckBox x:Name="AutoTranslateSwitch" Style="{StaticResource Switch}" Margin="0,18,0,0"
                        Content="{Binding [AutoTranslate], Source={x:Static s:Loc.I}}"
                        Checked="AutoTranslate_Changed" Unchecked="AutoTranslate_Changed"/>
              <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0"
                        Content="{Binding [StartWithWindows], Source={x:Static s:Loc.I}}"
                        Checked="Startup_Changed" Unchecked="Startup_Changed"/>

              <TextBlock Text="{Binding [Theme], Source={x:Static s:Loc.I}}" FontSize="12" Margin="0,16,0,0"
                         Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap"/>

              <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,0,0,0"
                          Click="OpenLink_Click" Tag="https://github.com/ShinRalexis/DeepLocal"
                          Foreground="{DynamicResource AccentText}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding [OpenGitHub], Source={x:Static s:Loc.I}}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,2,0,0"
                          Click="OpenLink_Click" Tag="https://liberapay.com/MetaDarko"
                          Foreground="{DynamicResource AccentText}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE006;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding [SupportLiberapay], Source={x:Static s:Loc.I}}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Border>

    <!-- ===================== Pannello di traduzione ===================== -->
    <Grid Grid.Row="1" Margin="20,20,20,6">
      <!-- Ombra su un bordo separato: un effetto sul pannello sfocherebbe il testo -->
      <Border CornerRadius="{StaticResource RadiusPanel}" Background="{DynamicResource Surface}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
      </Border>

      <Border CornerRadius="{StaticResource RadiusPanel}" Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Barra delle lingue: stesse colonne dei pannelli, inverti al centro sul divisore -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceLang" Style="{StaticResource LangCombo}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="8,0,48,0"
                      ToolTip="{Binding [SourceLangTip], Source={x:Static s:Loc.I}}"
                      AutomationProperties.Name="{Binding [SourceLangTip], Source={x:Static s:Loc.I}}"
                      SelectionChanged="SourceLang_SelectionChanged"/>
            <Button x:Name="SwapBtn" Grid.ColumnSpan="3" Style="{StaticResource IconButton}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Content="&#xE8AB;" Click="Swap_Click"
                    ToolTip="{Binding [SwapTip], Source={x:Static s:Loc.I}}"
                    AutomationProperties.Name="{Binding [SwapTip], Source={x:Static s:Loc.I}}"/>
            <ComboBox x:Name="TargetLang" Grid.Column="2" Style="{StaticResource LangCombo}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="32,0,8,0"
                      ToolTip="{Binding [TargetLangTip], Source={x:Static s:Loc.I}}"
                      AutomationProperties.Name="{Binding [TargetLangTip], Source={x:Static s:Loc.I}}"
                      SelectionChanged="TargetLang_SelectionChanged"/>
          </Grid>

          <Border Grid.Row="1" Background="{DynamicResource Divider}"/>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sorgente ===== -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBox x:Name="SourceBox" Style="{StaticResource PaneText}" TextChanged="SourceBox_TextChanged"
                       AutomationProperties.Name="{Binding [SourcePlaceholder], Source={x:Static s:Loc.I}}"/>

              <StackPanel x:Name="SourcePlaceholder" IsHitTestVisible="False" Margin="22,19,48,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding [SourcePlaceholder], Source={x:Static s:Loc.I}}" FontSize="18"
                           Foreground="{DynamicResource Placeholder}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding [SourceHint], Source={x:Static s:Loc.I}}" FontSize="13" Margin="0,8,0,0"
                           Foreground="{DynamicResource Placeholder}" TextWrapping="Wrap"/>
              </StackPanel>

              <Button x:Name="ClearBtn" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed"
                      Click="ClearAll_Click" ToolTip="{Binding [ClearTip], Source={x:Static s:Loc.I}}"
                      AutomationProperties.Name="{Binding [ClearTip], Source={x:Static s:Loc.I}}"/>

              <Grid Grid.Row="1" Margin="20,0,14,14">
                <TextBlock x:Name="CharCount" FontSize="12" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center"/>
                <Button x:Name="TranslateBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Click="TranslateBtn_Click" ToolTip="{Binding [TranslateTip], Source={x:Static s:Loc.I}}">
                  <TextBlock x:Name="TranslateBtnText" Text="{Binding [Translate], Source={x:Static s:Loc.I}}"/>
                </Button>
              </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource Divider}"/>

            <!-- ===== Traduzione ===== -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,11,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linea di attività in cima al pannello mentre il modello lavora -->
                <Canvas x:Name="BusyLine" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Hidden"
                        SizeChanged="BusyLine_SizeChanged">
                  <Rectangle x:Name="BusyBar" Width="140" Height="2" Fill="{DynamicResource Accent}" RadiusX="1" RadiusY="1">
                    <Rectangle.RenderTransform>
                      <TranslateTransform x:Name="BusyShift" X="-140"/>
                    </Rectangle.RenderTransform>
                  </Rectangle>
                </Canvas>

                <TextBox x:Name="TargetBox" Style="{StaticResource PaneText}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         AutomationProperties.Name="{Binding [TargetPlaceholder], Source={x:Static s:Loc.I}}"/>

                <TextBlock x:Name="TargetPlaceholder" Text="{Binding [TargetPlaceholder], Source={x:Static s:Loc.I}}"
                           IsHitTestVisible="False" Margin="22,19,48,0" VerticalAlignment="Top" FontSize="18"
                           Foreground="{DynamicResource Placeholder}"/>

                <!-- Errore con un'azione concreta, al posto della traduzione -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="20,18,20,0"
                        Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="14,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,2,12,0"
                               Foreground="{DynamicResource Danger}"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Ink}"/>
                      <Button x:Name="ErrorAction" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                              Margin="0,10,0,0" Click="ErrorAction_Click" Visibility="Collapsed"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,0,14,14">
                  <TextBlock x:Name="TargetInfo" FontSize="12" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                  <Button x:Name="CopyBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" MinHeight="36"
                          Click="CopyTranslated_Click" IsEnabled="False"
                          ToolTip="{Binding [CopyTip], Source={x:Static s:Loc.I}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="CopyText" Text="{Binding [Copy], Source={x:Static s:Loc.I}}" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== Barra di stato ===================== -->
    <Grid Grid.Row="2" Margin="24,0,24,8" Height="24">
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Margin="0,0,220,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource InkMuted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="OllamaStatus" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="7,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
